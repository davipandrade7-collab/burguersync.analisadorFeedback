# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token
GITHUB_PERSONAL_TOKEN=your_github_token_here

# Configurações opcionais de SMTP para disparo de e-mails de crise:
# (Caso não preenchido, os alertas são gravados automaticamente em .tmp/alerts.log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
ALERT_EMAIL_TO=gerencia.ourinhos@burgersync.com
